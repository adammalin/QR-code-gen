{
  "name": "qr-code-gen",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc --noEmit && vite build",
    "build:mcp": "tsc --noEmit -p tsconfig.mcp.json && node scripts/build-mcp.mjs",
    "build": "npm run build:web && npm run build:mcp",
    "start": "node plugins/qr-studio/server/host.mjs",
    "mcp": "node plugins/qr-studio/server/index.mjs",
    "package:plugin": "node scripts/package-plugin.mjs",
    "preview": "vite preview",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/mulish": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@resvg/resvg-js": "2.6.2",
    "jsdom": "26.1.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "qr-code-styling": "1.9.2",
    "qrcode-generator": "1.4.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
